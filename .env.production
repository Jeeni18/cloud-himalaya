# Committed, non-secret defaults applied to production builds. Next.js loads
# this file during "next build" and "next start", so it works on any hosting
# platform without configuring anything in a dashboard.
#
# NEVER put secrets in this file: it is in version control. Secrets belong in
# .env locally (git-ignored) or in the hosting platform's own settings.

# Frontend-only preview: build and serve the site with no database, so the
# design can be reviewed before the production Postgres instance and Payload
# migrations exist. The CMS-backed routes show a "not published yet"
# placeholder and /admin is not usable.
#
# A real DATABASE_URL always takes precedence over this flag, so setting
# DATABASE_URL in the hosting platform switches the CMS back on with no code
# change. Delete this file once the database is permanent.
PREVIEW_WITHOUT_CMS=true
