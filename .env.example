DATABASE_URL=postgres://USERNAME:PASSWORD@127.0.0.1:5433/cloud_himalaya
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Where the "Client Login" links and the /client-login short URL send
# visitors. Must be an absolute http(s) URL. Optional: if unset, the
# site falls back to the placeholder in src/config/site.ts.
CLIENT_PORTAL_URL=https://portal.cloudhimalaya.com

# Frontend-only preview deployments (for example a Vercel preview shown for
# design review before the production database exists).
#
# Set to "true" to run the site with no CMS: CMS-backed sections render
# their empty state, and CMS-only routes show a "not published yet"
# placeholder. PAYLOAD_SECRET then becomes optional too. The admin panel at
# /admin is not usable in this mode.
#
# It only takes effect when no DATABASE_URL is configured -- a real
# DATABASE_URL always wins -- so a database outage still fails loudly
# instead of silently serving an empty site.
#
# This is currently switched on for production builds by the committed
# .env.production file, so it does not need setting here.
PREVIEW_WITHOUT_CMS=
